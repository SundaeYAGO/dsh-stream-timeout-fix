{
  "name": "dsh-stream-timeout-fix",
  "version": "1.0.0",
  "description": "DSH host plugin for third-party/self-hosted OpenAI-compatible endpoints: replace undici's default 300s body/headers timeouts so long silent gaps in LLM SSE streams no longer die as misleading 'TypeError: terminated' (TRANSPORT) errors. No retry logic included.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "test",
    "scripts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SundaeYAGO/dsh-stream-timeout-fix.git"
  },
  "homepage": "https://github.com/SundaeYAGO/dsh-stream-timeout-fix#readme",
  "bugs": {
    "url": "https://github.com/SundaeYAGO/dsh-stream-timeout-fix/issues"
  },
  "dependencies": {
    "undici": "^8.11.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "undici",
    "fetch",
    "bodyTimeout",
    "headersTimeout",
    "terminated",
    "UND_ERR_BODY_TIMEOUT",
    "SSE",
    "streaming",
    "LLM",
    "timeout",
    "keepalive",
    "litellm",
    "vllm",
    "self-hosted",
    "private-deployment",
    "vibe-coding"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
